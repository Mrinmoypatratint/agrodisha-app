require "spaceship"

default_platform(:ios)

platform :ios do
  before_all do
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LANGUAGE"] = "en_US:en"
    ENV["LC_ALL"] = "en_US.UTF-8"
  end

  desc "Setup App Store Connect API Key"
  private_lane :load_api_key do
    app_store_connect_api_key(
      key_id: ENV["APPLE_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APPLE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APPLE_KEY_CONTENT"] || ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Setup temporary CI Keychain for signing"
  private_lane :setup_ci_keychain do
    create_keychain(
      name: "ci_keychain",
      password: "temporary_ci_password_123",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )
  end

  desc "Clean up temporary CI Keychain"
  private_lane :cleanup_ci_keychain do
    delete_keychain(name: "ci_keychain") if File.exist?(File.expand_path("~/Library/Keychains/ci_keychain-db"))
  end

  desc "Build signed iOS IPA (Phase 13 - CI Validation without publishing)"
  lane :build_ios do
    api_key = load_api_key
    setup_ci_keychain

    # Ensure there is an available Distribution certificate slot on Apple Developer portal.
    # Apple allows at most 2 active Distribution certificates.
    # Since ephemeral CI runners lack private keys of previous runs, get_certificates
    # must generate a new certificate. If 2 already exist, we revoke the oldest to make room.
    begin
      certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = certs.select do |c|
        c.certificate_type.to_s.upcase.include?("DISTRIBUTION")
      end
      UI.message("Found #{dist_certs.count} active distribution certificate(s) on Apple Developer portal.")
      dist_certs.each do |c|
        UI.message("  - Cert: id=#{c.id}, name=#{c.name}, type=#{c.certificate_type}, expires=#{c.expiration_date}")
      end

      # First remove any expired certificates
      now = Time.now
      dist_certs.each do |c|
        if c.expiration_date && (Time.parse(c.expiration_date) rescue now + 1) < now
          UI.important("Revoking expired distribution certificate #{c.id} (#{c.name})...")
          begin
            c.delete!
          rescue => del_ex
            UI.error("Failed to delete expired cert #{c.id}: #{del_ex.message}")
            Spaceship::ConnectAPI.delete_certificate(certificate_id: c.id) rescue nil
          end
        end
      end

      # Refresh list
      certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = certs.select do |c|
        c.certificate_type.to_s.upcase.include?("DISTRIBUTION")
      end

      # If 2 or more distribution certificates still exist, revoke oldest until at most 1 remains
      if dist_certs.count >= 2
        sorted = dist_certs.sort_by { |c| c.expiration_date || "" }
        while sorted.count >= 2
          oldest = sorted.shift
          UI.important("Revoking distribution certificate #{oldest.id} (#{oldest.name}) to stay within Apple's 2-certificate limit...")
          begin
            oldest.delete!
            UI.success("Successfully revoked certificate #{oldest.id}.")
          rescue => del_ex
            UI.error("Failed to delete cert #{oldest.id}: #{del_ex.message}")
            Spaceship::ConnectAPI.delete_certificate(certificate_id: oldest.id) rescue nil
          end
          sleep(2)
        end
      end
    rescue => ex
      UI.error("Error managing distribution certificates: #{ex.message}")
    end

    # Fetch distribution certificate from Apple Developer portal and install into CI keychain
    get_certificates(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/ci_keychain-db"),
      keychain_password: "temporary_ci_password_123"
    )

    # Fetch or create App Store provisioning profile for com.agrohisha.app
    # Force recreate to pick up newly enabled capabilities (Push, Sign in with Apple, Associated Domains)
    profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.agrohisha.app",
      force: true
    )

    # Configure Xcode project for manual signing in CI
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/Runner.xcodeproj",
      team_id: "2BSV4VG5A7",
      bundle_identifier: "com.agrohisha.app",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "iPhone Distribution"
    )

    # Disable SPM to ensure CocoaPods compatibility
    sh("flutter config --no-enable-swift-package-manager")

    # Clean and prepare dependencies
    sh("flutter clean")
    sh("rm -rf ios/Pods ios/Podfile.lock")
    sh("flutter precache --ios")
    sh("flutter pub get")

    # Check latest build number from TestFlight to avoid duplicate build rejection
    current_build = 3
    begin
      latest_build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "com.agrohisha.app"
      )
      current_build = [latest_build + 1, current_build].max if latest_build
      UI.message("Resolved App Store Connect build number: #{current_build}")
    rescue => ex
      UI.message("Could not fetch remote build number (first build or pending record): #{ex.message}. Using build number #{current_build}")
    end

    # Ensure project.pbxproj does not hardcode FLUTTER_BUILD_NUMBER or old CURRENT_PROJECT_VERSION
    pbxproj_path = File.expand_path("../ios/Runner.xcodeproj/project.pbxproj")
    if File.exist?(pbxproj_path)
      content = File.read(pbxproj_path)
      content.gsub!(/\t*FLUTTER_BUILD_NUMBER = .*;\n/, "")
      content.gsub!(/CURRENT_PROJECT_VERSION = .*;/, 'CURRENT_PROJECT_VERSION = "$(FLUTTER_BUILD_NUMBER)";')
      content.gsub!(/MARKETING_VERSION = .*;/, 'MARKETING_VERSION = "$(FLUTTER_BUILD_NAME)";')
      File.write(pbxproj_path, content)
    end

    # Generate ExportOptions.plist for flutter build ipa
    export_options_path = File.expand_path("../ios/ExportOptions.plist")
    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>2BSV4VG5A7</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>com.agrohisha.app</key>
          <string>#{lane_context[SharedValues::SIGH_NAME]}</string>
        </dict>
      </dict>
      </plist>
    PLIST

    # Build production signed IPA with explicit export options
    sh("flutter build ipa --release --build-name=2.0.0 --build-number=#{current_build} --export-options-plist=#{export_options_path}")

    repo_root = File.expand_path("..", __dir__)
    ipa_candidates = Dir[File.join(repo_root, "build/ios/ipa/*.ipa")] + Dir[File.join(repo_root, "build/ios/archive/*.ipa")] + Dir["build/ios/ipa/*.ipa"] + Dir["**/*.ipa"]
    ipa_path = ipa_candidates.compact.uniq.find { |f| File.exist?(f) && f.end_with?(".ipa") }
    UI.user_error!("Could not find built IPA file! Searched: #{ipa_candidates}") unless ipa_path
    UI.message("Resolved generated IPA path: #{ipa_path}")
    lane_context[SharedValues::IPA_OUTPUT_PATH] = ipa_path
    ENV["DELIVER_IPA_PATH"] = ipa_path

    # Verify built IPA Info.plist version
    require "tmpdir"
    unzip_tmp = Dir.mktmpdir
    begin
      sh("unzip -q '#{ipa_path}' -d '#{unzip_tmp}'")
      app_dir = Dir[File.join(unzip_tmp, "Payload", "*.app")].first
      if app_dir
        info_plist = File.join(app_dir, "Info.plist")
        version_name = `/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "#{info_plist}"`.strip rescue "unknown"
        version_code = `/usr/libexec/PlistBuddy -c "Print CFBundleVersion" "#{info_plist}"`.strip rescue "unknown"
        UI.success("Built IPA Verification: CFBundleShortVersionString=#{version_name}, CFBundleVersion=#{version_code}")
      end
    rescue => ex
      UI.message("Could not inspect IPA Info.plist: #{ex.message}")
    ensure
      FileUtils.rm_rf(unzip_tmp) rescue nil
    end

    cleanup_ci_keychain
  end

  desc "Build and upload to TestFlight (Phase 15)"
  lane :beta do
    build_ios

    api_key = load_api_key
    repo_root = File.expand_path("..", __dir__)
    ipa_candidates = [lane_context[SharedValues::IPA_OUTPUT_PATH]] + Dir[File.join(repo_root, "build/ios/ipa/*.ipa")] + Dir["build/ios/ipa/*.ipa"] + Dir["**/*.ipa"]
    ipa_path = ipa_candidates.compact.uniq.find { |f| File.exist?(f) && f.end_with?(".ipa") }
    UI.user_error!("Could not locate IPA for TestFlight upload! Searched: #{ipa_candidates}") unless ipa_path

    UI.message("Uploading IPA to TestFlight: #{ipa_path}")
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.agrohisha.app",
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload production release to App Store Connect without submitting for review"
  lane :release do
    build_ios

    api_key = load_api_key
    repo_root = File.expand_path("..", __dir__)
    ipa_candidates = [lane_context[SharedValues::IPA_OUTPUT_PATH]] + Dir[File.join(repo_root, "build/ios/ipa/*.ipa")] + Dir["build/ios/ipa/*.ipa"] + Dir["**/*.ipa"]
    ipa_path = ipa_candidates.compact.uniq.find { |f| File.exist?(f) && f.end_with?(".ipa") }
    UI.user_error!("Could not locate IPA for App Store upload! Searched: #{ipa_candidates}") unless ipa_path

    UI.message("Uploading IPA to App Store: #{ipa_path}")
    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.agrohisha.app",
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  error do |lane, exception|
    cleanup_ci_keychain
  end
end
